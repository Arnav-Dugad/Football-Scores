{
  "name": "football-scores",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/build-pwa.mjs",
    "build:cloudflare": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "build:vercel": "npm run build && node scripts/build-vercel.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/model.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "format": "prettier --write src shared server worker api tests scripts *.ts *.json *.jsonc *.js *.html .github/workflows docs README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.4.0",
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.10",
    "vitest": "^5.0.4",
    "wrangler": "^4.43.0"
  },
  "overrides": {
    "playwright-core": "$playwright-core"
  }
}
